{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dual-reviewer:foundation:necessity_judgment:1.0.0",
  "title": "necessity_judgment",
  "description": "Step C の出力単位。必要性 5-field・final label・recommended action・optional override reason を固定（Requirement 3 受入 6、design §4 necessity_judgment）。judgment 質評価/policy は runtime/evaluation 委譲。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "requirement_link", "ignored_impact", "fix_cost",
    "scope_expansion", "uncertainty", "final_label", "recommended_action"
  ],
  "properties": {
    "requirement_link": { "description": "mandatory-B1.0。必要性 5-field の 1。" },
    "ignored_impact": { "description": "mandatory-B1.0。必要性 5-field の 2。" },
    "fix_cost": { "description": "mandatory-B1.0。必要性 5-field の 3。" },
    "scope_expansion": { "description": "mandatory-B1.0。必要性 5-field の 4。" },
    "uncertainty": { "description": "mandatory-B1.0。必要性 5-field の 5。" },
    "final_label": { "type": "string", "description": "mandatory-B1.0。最終ラベル。" },
    "recommended_action": { "type": "string", "description": "mandatory-B1.0。推奨アクション。" },
    "override_reason": { "type": ["string", "null"], "description": "optional。override 時の理由。" }
  },
  "x-versioning-note": "versioned artifact。silent な非互換編集を禁ずる（Requirement 3 受入 3）。"
}
