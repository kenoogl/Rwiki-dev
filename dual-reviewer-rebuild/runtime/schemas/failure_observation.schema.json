{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dual-reviewer:foundation:failure_observation:1.0.0",
  "title": "failure_observation",
  "description": "Structured record for misses, disagreement, or process failure observed during review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "failure_observation_id",
    "run_id",
    "step_id",
    "failure_mode",
    "summary",
    "evidence_refs",
    "detected_by",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "failure_observation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "related_finding_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_mode": {
      "type": "string",
      "enum": [
        "missed_issue",
        "false_positive",
        "unsupported_claim",
        "unresolved_disagreement",
        "incomplete_evidence",
        "process_gap",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "detected_by": {
      "type": "string",
      "enum": [
        "primary_reviewer",
        "adversarial_reviewer",
        "judgment_reviewer",
        "validator",
        "human_operator"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
