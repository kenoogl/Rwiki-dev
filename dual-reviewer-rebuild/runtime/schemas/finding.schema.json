{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dual-reviewer:foundation:finding:1.0.0",
  "title": "finding",
  "description": "最小 review evidence unit。下記 field はすべて mandatory-B1.0（Requirement 3 受入 5）。B-1.0 で deferred の拡張点はない（design §4 finding）。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "finding_id", "step_id", "source_role", "severity", "summary",
    "source_refs", "counter_evidence_refs", "judgment_ref",
    "decision_unit_id", "human_decision_ref", "adversarial_outcome"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "step_id": { "type": "string" },
    "source_role": {
      "type": "string",
      "description": "abstract role 名（primary_reviewer / adversarial_reviewer / judgment_reviewer）"
    },
    "severity": { "type": "string" },
    "summary": { "type": "string" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "counter_evidence_refs": { "type": "array", "items": { "type": "string" } },
    "judgment_ref": { "type": ["string", "null"] },
    "decision_unit_id": { "type": ["string", "null"] },
    "human_decision_ref": { "type": ["string", "null"] },
    "adversarial_outcome": {
      "type": "string",
      "description": "Step B 敵対役の反証有無を意図的結果として記録（Requirement 1 受入 4）。語彙拡張は deferred（runtime/evaluation 委譲）。",
      "enum": [
        "counter_evidence_raised",
        "no_counter_evidence_after_challenge",
        "not_assessed"
      ]
    }
  },
  "x-versioning-note": "versioned artifact。silent な非互換編集を禁ずる（Requirement 3 受入 3）。"
}
