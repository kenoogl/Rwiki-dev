{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dual-reviewer:foundation:review_case:1.0.0",
  "title": "review_case",
  "description": "run-level envelope。run metadata・step record 境界・finding 群・validation/invalidation 参照を持つ。derived metrics は持たない（design §4 review_case）。全 field は特記なき限り mandatory-B1.0。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "review_case_id",
    "metadata",
    "step_records",
    "findings",
    "validation_refs"
  ],
  "properties": {
    "review_case_id": { "type": "string", "description": "mandatory-B1.0" },
    "metadata": {
      "type": "object",
      "description": "mandatory-B1.0。runtime/foundation/metadata_contract.yaml の必須 field 集合を満たす run-level metadata。",
      "required": [
        "run_id", "target_id", "target_artifact_hash", "source_repository_id",
        "source_revision", "phase_profile", "treatment", "review_mode",
        "protocol_version", "runtime_version", "schema_set_version",
        "prompt_set_version", "config_version", "config_hash", "run_status",
        "validator_status", "human_signoff_status", "evidence_class", "started_at"
      ]
    },
    "step_records": {
      "type": "array",
      "description": "mandatory-B1.0。step-level replay identity（design §5）。",
      "items": {
        "type": "object",
        "required": [
          "step_id", "step_name", "step_status",
          "step_prompt_artifact_id", "step_started_at", "step_closed_at"
        ],
        "properties": {
          "step_id": { "type": "string" },
          "step_name": { "type": "string" },
          "step_status": { "type": "string" },
          "step_prompt_artifact_id": { "type": "string" },
          "step_started_at": { "type": "string" },
          "step_closed_at": { "type": ["string", "null"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "mandatory-B1.0。finding.schema.json に従う finding 群。",
      "items": { "type": "object" }
    },
    "validation_refs": {
      "type": "object",
      "description": "mandatory-B1.0。validator_result / invalidation_marker artifact への参照。",
      "properties": {
        "validator_result_ref": { "type": ["string", "null"] },
        "invalidation_marker_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "x-versioning-note": "versioned artifact。silent な非互換編集を禁ずる（Requirement 3 受入 3）。schema directory 規約に従う。"
}
