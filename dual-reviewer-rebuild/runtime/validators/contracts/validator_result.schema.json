{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dual-reviewer:foundation:validator:validator_result:1.0.0",
  "title": "validator_result",
  "description": "Validation execution result emitted at run close.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validator_result_id",
    "run_id",
    "validator_name",
    "validator_version",
    "review_mode",
    "overall_status",
    "executed_at",
    "checks",
    "invalidation_marker_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "validator_result_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "validator_name": {
      "type": "string",
      "minLength": 1
    },
    "validator_version": {
      "type": "string",
      "minLength": 1
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "manual_dogfooding",
        "runtime_mediated",
        "imported_bundle"
      ]
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "error"
      ]
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "invalidation_marker_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
