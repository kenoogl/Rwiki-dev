// Figure 2: Directed rework graph across the spec-driven development cycle.
// Labels are in English; caption is maintained separately in fig2-caption.md.
// Source: evidence-extract-2026-05-20.md sections 1-6.

digraph rework {
  rankdir=LR;
  nodesep=0.35;        // vertical spacing between Leak and phase row reduced
  ranksep=0.5;         // compressed but leaves room for B's top route
  splines=ortho;       // orthogonal routing: horizontal and vertical segments
  pad=0.15;            // tight outer margin
  bgcolor="white";

  node [
    fontname="Helvetica, Arial, sans-serif",
    style="rounded,filled",
    fillcolor="#f5f5f5",
    shape=box,
    fontsize=12,
    margin="0.20,0.12"
  ];
  edge [fontname="Helvetica, Arial, sans-serif", fontsize=15];

  // Phase boxes (left to right along the spec-driven cycle).
  // Design and Impl carry inline count annotations (Br, A) in lieu of
  // separate self-loop edges, which were ambiguous under splines=ortho.
  intent [label="Intent"];
  req    [label="Requirements"];
  design [label=<Design<BR/><FONT POINT-SIZE="11" COLOR="#374151">[Br = 10]</FONT>>];
  tasks  [label="Tasks"];
  impl   [label=<Implementation /<BR/>Conformance<BR/><FONT POINT-SIZE="11" COLOR="#1f2937">[A = 44]</FONT>>];

  // Leak node with human-audit icon (independent later inspection)
  leak [
    label="👤 Leak\n(human audit)",
    shape=ellipse,
    style=filled,
    fillcolor="#fff3b0",
    fontcolor="#7a4f01"
  ];

  // Forward process flow (black arrows). All forward edges use minlen=1 now;
  // the right-half rework no longer needs extra columns because A and Br
  // are inline annotations and only B (above) and the leak edges remain.
  intent -> req    [color="black", penwidth=1.6, weight=10, minlen=1];
  req    -> design [color="black", penwidth=1.6, weight=10, minlen=1];
  design -> tasks  [color="black", penwidth=1.6, weight=10, minlen=1];
  tasks  -> impl   [color="black", penwidth=1.6, weight=10, minlen=1];

  // Note: ortho routing does not honor 'label='; use 'xlabel=' (external labels)

  // Rework A (task-local absorption) is shown as an inline annotation on the
  // Impl node label (see "[A = 44]" above). No self-loop edge is drawn here,
  // because splines=ortho cannot lay self-loops out cleanly alongside B.

  // Rework B: implementation back to design, routed above the boxes.
  // ortho ignores tailport/headport when laying out the channel; we instead
  // force a top route by switching to dir=back (so the source node is "design"
  // in graphviz's mind, exiting upward) and by removing layout constraint.
  design -> impl [
    xlabel="B",
    penwidth=2.6,
    color="#d97706",
    fontcolor="#92400e",
    dir=back,
    constraint=false,
    tailport=n,
    headport=n
  ];

  // Rework Br (post-handback redesign) is shown as an inline annotation on
  // the Design node label (see "[Br = 10]" above). No self-loop edge here.

  // Leak edges: prior-gate bypass detected by human audit later.
  // L1 was actually remediated at the implementation layer (real-output fixtures);
  // L2 was remediated at the tasks layer (dependency-graph supplement).
  leak -> impl [
    xlabel="L1",
    color="#dc2626",
    fontcolor="#991b1b",
    penwidth=2.2,
    style=bold
  ];
  leak -> tasks [
    xlabel="L2",
    color="#dc2626",
    fontcolor="#991b1b",
    penwidth=1.6,
    style=bold
  ];

  // Rework C (Impl -> Requirements) and D (Impl -> Intent) are
  // zero across all six features and therefore not drawn; see caption.
}
